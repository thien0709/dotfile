# -----------------------------------------------------------------------------
# 1. SYSTEM & APPLICATIONS
# -----------------------------------------------------------------------------

# Terminal Emulator (Alacritty)
super + Return
	alacritty

# Program Launcher (Rofi)
super + space
	rofi -show drun

# Web Browser (Firefox) - CHANGE THIS if you use Chrome/Brave
super + w
	microsoft-edge-stable

# File Manager (Thunar) - CHANGE THIS if you use PCManFM/Dolphin
super + e
	alacritty -e ranger

# Reload sxhkd configuration
super + Escape
	pkill -USR1 -x sxhkd

# System Powermenu (Eww)
# Changed from 'super + l' to avoid conflict with navigation
super + x
	betterlockscreen -l blur

# Quit or Restart BSPWM
super + alt + {q,r}
	bspc {quit,wm -r}

# -----------------------------------------------------------------------------
# 2. WINDOW MANAGEMENT (BSPWM)
# -----------------------------------------------------------------------------

# Close (close app) or Kill (force kill)
super + {_,shift + }q
	bspc node -{c,k}

# Alternate between Tiled and Monocle layout
super + m
	bspc desktop -l next

# Swap current node with the biggest window
super + g
	bspc node -s biggest.window

# Set Window State: Tiled, Pseudo-tiled, Floating, Fullscreen
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Set Node Flags: Marked, Locked, Sticky, Private
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# -----------------------------------------------------------------------------
# 3. FOCUS & NAVIGATION (Vim Keys)
# -----------------------------------------------------------------------------

# Focus node (move cursor) or Swap node (move window)
# h = left, j = down, k = up, l = right
super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# Focus the next/previous window on current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# Focus the next/previous desktop
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# Focus last node or last desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# Focus specific desktop (1-10) or Move window to desktop (1-10)
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

# -----------------------------------------------------------------------------
# 4. PRESELECT & RESIZING
# -----------------------------------------------------------------------------

# Preselect direction (visualize where next window goes)
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# Cancel preselection
super + ctrl + space
	bspc node -p cancel

# Resize window (Expand/Contract)
# Note: Syntax optimized for readability
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Move floating windows
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# -----------------------------------------------------------------------------
# 5. AESTHETICS (Gaps & Padding)
# -----------------------------------------------------------------------------

# Increase/Decrease window gaps (Space between windows)
super + {equal,minus}
	bspc config window_gap $(( $(bspc config window_gap) {+, -} 5 ))

# Reset gaps to default (10px)
super + alt + 0
	bspc config window_gap 10

# -----------------------------------------------------------------------------
# 6. HARDWARE & MEDIA KEYS
# -----------------------------------------------------------------------------

# Volume Controls (PulseAudio/Pipewire)
XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brightness Controls
XF86MonBrightnessUp
	brightnessctl s +10%

XF86MonBrightnessDown
	brightnessctl s 10%-

# Media Player Controls (Requires: playerctl)
XF86Audio{Play,Prev,Next}
	playerctl {play-pause,previous,next}

# -----------------------------------------------------------------------------
# 7. SCREENSHOTS (Scrot)
# -----------------------------------------------------------------------------

# Full Screenshot -> Save to folder -> Copy to Clipboard
Print
	mkdir -p ~/Pictures/Screenshots && \
	scrot 'screenshot_%Y-%m-%d-%H%M%S.png' -e 'mv $f ~/Pictures/Screenshots/ && xclip -selection clipboard -t image/png -i ~/Pictures/Screenshots/$f'

# Select Area Screenshot -> Save to folder -> Copy to Clipboard
super + shift + s
	mkdir -p ~/Pictures/Screenshots && \
	scrot -s 'screenshot_%Y-%m-%d-%H%M%S.png' -e 'mv $f ~/Pictures/Screenshots/ && xclip -selection clipboard -t image/png -i ~/Pictures/Screenshots/$f'
